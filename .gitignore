# Dependencies
node_modules/
.pnpm-store/

# Next.js build/cache
.next/
next-env.d.ts
*.tsbuildinfo

# Generated QA / reports
artifacts/

# Local runtime/cache data
.data/

# Test outputs
test-results/
playwright-report/

# Logs
logs/

# Deployment packages and local backups
dist/
pokemon-backups/
.local-backups/

# Local environment settings
.env*
!.env.example
/env.download

# Personal Windows entry points stay on this PC.
/포켓몬타워 실행.exe
/포켓몬타워 실행.cmd

# Local conversation attachments and large reproducible experiment logs.
.codex-remote-attachments/

# Future optional external originals and generated runtime copies.
# Other public/vendor packs remain tracked until reproduction is verified.
/public/vendor/pokerogue/
/public/vendor/showdown/pokemon/
/public/vendor/pokeapi/
/external/pokemon-ip/*
!/external/pokemon-ip/README.md
/external/user-provided/unverified/*
!/external/user-provided/unverified/README.md
/public/assets/external-generated/

