{
  "name": "pokemon-tower",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node --require ./scripts/windows-build-links.cjs node_modules/next/dist/bin/next build",
    "deploy:package": "pnpm build && node scripts/package-deploy.mjs",
    "deploy:verify": "node scripts/verify-deploy.mjs",
    "deploy:verify:docker": "node scripts/verify-container.mjs",
    "preview:start": "node scripts/preview.mjs start",
    "preview:stop": "node scripts/preview.mjs stop",
    "preview:status": "node scripts/preview.mjs status",
    "db:backup": "node scripts/backup-db.mjs",
    "start": "next start --hostname 127.0.0.1",
    "test:e2e": "playwright test",
    "battle": "tsx src/cli.ts",
    "battle:auto": "tsx src/cli.ts --auto",
    "tower:audit": "tsx src/tower-audit.ts",
    "raid:simulate": "tsx scripts/simulate-raids.ts",
    "data:import": "tsx scripts/import-battle-roster.ts",
    "assets:pokerogue": "node scripts/assets/pokerogue/restore.mjs",
    "assets:pokerogue:verify": "node scripts/assets/pokerogue/verify.mjs",
    "assets:showdown-pokemon": "node scripts/assets/showdown-pokemon/restore.mjs",
    "assets:showdown-pokemon:verify": "node scripts/assets/showdown-pokemon/verify.mjs",
    "assets:pokeapi": "node scripts/assets/pokeapi/restore.mjs",
    "assets:pokeapi:verify": "node scripts/assets/pokeapi/verify.mjs",
    "battle:audit": "tsx scripts/audit-battle-roster.ts",
    "sprites:audit": "node scripts/audit-sprite-assets.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/check-css-structure.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "clean:temp": "node scripts/clean-generated.mjs --apply",
    "assets:trainers": "node scripts/assets/mixed/runtime.mjs restore trainers",
    "assets:trainers:verify": "node scripts/assets/mixed/runtime.mjs verify trainers",
    "assets:gimmicks": "node scripts/assets/mixed/runtime.mjs restore gimmicks",
    "assets:gimmicks:verify": "node scripts/assets/mixed/runtime.mjs verify gimmicks",
    "assets:items": "node scripts/assets/mixed/runtime.mjs restore items",
    "assets:items:verify": "node scripts/assets/mixed/runtime.mjs verify items",
    "assets:showdown-trainers": "node scripts/assets/mixed/runtime.mjs restore showdown-trainers",
    "assets:showdown-trainers:verify": "node scripts/assets/mixed/runtime.mjs verify showdown-trainers",
    "assets:showdown-gimmicks": "node scripts/assets/mixed/runtime.mjs restore showdown-gimmicks",
    "assets:showdown-gimmicks:verify": "node scripts/assets/mixed/runtime.mjs verify showdown-gimmicks",
    "assets:pokeapi-gimmick-items": "node scripts/assets/mixed/runtime.mjs restore pokeapi-gimmick-items",
    "assets:pokeapi-gimmick-items:verify": "node scripts/assets/mixed/runtime.mjs verify pokeapi-gimmick-items",
    "assets:pokeapi-items": "node scripts/assets/mixed/runtime.mjs restore pokeapi-items",
    "assets:pokeapi-items:verify": "node scripts/assets/mixed/runtime.mjs verify pokeapi-items",
    "assets:pokeapi-legacy-items": "node scripts/assets/mixed/runtime.mjs restore pokeapi-legacy-items",
    "assets:pokeapi-legacy-items:verify": "node scripts/assets/mixed/runtime.mjs verify pokeapi-legacy-items",
    "assets:pokesprite-items": "node scripts/assets/mixed/runtime.mjs restore pokesprite-items",
    "assets:pokesprite-items:verify": "node scripts/assets/mixed/runtime.mjs verify pokesprite-items",
    "assets:pokerogue-items": "node scripts/assets/mixed/runtime.mjs restore pokerogue-items",
    "assets:pokerogue-items:verify": "node scripts/assets/mixed/runtime.mjs verify pokerogue-items",
    "assets:mixed": "node scripts/assets/mixed/runtime.mjs restore all",
    "assets:mixed:verify": "node scripts/assets/mixed/runtime.mjs verify all"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "next": "16.3.8",
    "pokemon-showdown": "0.11.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
