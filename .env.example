# Only needed behind a reverse proxy; must match the browser's origin exactly.
# TOWER_ORIGIN=https://game.example.com

# Local persistent SQLite file. Changing this path selects a different save database.
# TOWER_DB_PATH=.data/tower.sqlite

# Optional local development sign-in: an existing username in the selected DB.
# Only next dev on a loopback host accepts this; production always requires login.
# TOWER_LOCAL_ACCOUNT=your_username

# Docker Compose host-side port (container always listens on 3000).
# If changed for local testing, also update TOWER_ORIGIN to match.
# TOWER_PORT=3000
